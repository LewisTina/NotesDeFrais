<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NotesDeFrais.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:NotesDeFrais.Pages"
    Title="NotesDeFrais"
    Shell.BackgroundColor="{StaticResource Surface}"
    Shell.ForegroundColor="{StaticResource Ink}"
    Shell.TitleColor="{StaticResource Ink}"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarForegroundColor="{StaticResource Muted}"
    Shell.TabBarTitleColor="{StaticResource Accent}"
    Shell.TabBarUnselectedColor="{StaticResource Muted}">

    <TabBar>
        <ShellContent
            Title="Session"
            Icon="icon_session.svg"
            ContentTemplate="{DataTemplate pages:SessionPage}"
            Route="SessionPage" />
        <ShellContent
            Title="Nouvelle"
            Icon="icon_new_expense.svg"
            ContentTemplate="{DataTemplate pages:NewExpensePage}"
            Route="NewExpensePage" />
        <ShellContent
            Title="Mes demandes"
            Icon="icon_expenses.svg"
            ContentTemplate="{DataTemplate pages:MyExpensesPage}"
            Route="MyExpensesPage" />
        <ShellContent
            Title="Admin"
            Icon="icon_admin.svg"
            ContentTemplate="{DataTemplate pages:AdminExpensesPage}"
            Route="AdminExpensesPage" />
    </TabBar>

</Shell>
